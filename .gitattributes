*.js linguist-detectable=false

# Plugin packages are verified byte for byte against the built-in trust
# catalog, so reviewed sources must keep their LF bytes on every platform.
docs/examples/plugins/** text eol=lf
test/fixtures/plugins/** text=auto eol=lf

# Signed bundles and upstream license text retain their original bytes.
test/fixtures/plugins/web-clipper-1.1.0/extract.js -whitespace linguist-generated=true
test/fixtures/plugins/web-clipper-1.1.0/THIRD_PARTY_NOTICES.md -whitespace

# ignore diff for generated files
*.gen.dart binary
*.gen.dart linguist-generated=true
