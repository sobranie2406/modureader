{
  "schemaVersion": 1,
  "hostApi": 1,
  "id": "com.modu.ai-annotator",
  "version": "1.0.0",
  "name": {
    "zh-CN": "AI 批注助手",
    "en": "AI annotator"
  },
  "description": {
    "zh-CN": "用你自己配置的模型解释所选文字，可一键存为笔记或复制。演示 ai.complete、notes.save、ui.select 与 ui.progress。",
    "en": "Explain the selection with your own model, then save it as a note or copy it. Demonstrates ai.complete, notes.save, ui.select and ui.progress."
  },
  "author": {
    "name": "Modu contributors",
    "url": "https://github.com/sobranie2406/modureader"
  },
  "license": "MIT",
  "minAppVersion": "1.3.10",
  "capabilities": [
    "script:run",
    "ai:invoke",
    "ui:selection-action",
    "note:write",
    "ui:dialog",
    "ui:progress",
    "clipboard:write"
  ],
  "contributes": [
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "explain-and-save",
      "name": {
        "zh-CN": "AI 解释并存为批注",
        "en": "Explain and save"
      },
      "entry": "main.js",
      "surface": "selection",
      "scope": "context"
    }
  ],
  "settings": [
    {
      "key": "style",
      "type": "select",
      "label": {
        "zh-CN": "解释风格",
        "en": "Explanation style"
      },
      "options": [
        "plain",
        "example",
        "exam"
      ],
      "defaultValue": "plain"
    },
    {
      "key": "max_chars",
      "type": "number",
      "label": {
        "zh-CN": "回答上限（字）",
        "en": "Answer limit (characters)"
      },
      "defaultValue": 400
    },
    {
      "key": "auto_save",
      "type": "toggle",
      "label": {
        "zh-CN": "无需确认直接存为批注",
        "en": "Save without asking"
      },
      "description": {
        "zh-CN": "关闭时会先询问你是否保存。",
        "en": "When off, you are asked before anything is saved."
      },
      "defaultValue": false
    }
  ]
}
