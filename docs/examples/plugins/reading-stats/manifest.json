{
  "schemaVersion": 1,
  "hostApi": 1,
  "id": "com.modu.reading-stats",
  "version": "1.0.0",
  "name": {
    "zh-CN": "阅读统计卡",
    "en": "Reading report"
  },
  "description": {
    "zh-CN": "按天数汇总阅读时长与书目排行，并复制成一段可直接分享的文字。演示 reading:read 与 clipboard:write。",
    "en": "Summarise reading time and the top books over a window, then copy a shareable summary. Demonstrates reading:read and clipboard:write."
  },
  "author": {
    "name": "Modu contributors",
    "url": "https://github.com/sobranie2406/modureader"
  },
  "license": "MIT",
  "minAppVersion": "1.3.10",
  "capabilities": [
    "script:run",
    "reading:read",
    "clipboard:write"
  ],
  "contributes": [
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "monthly-report",
      "name": {
        "zh-CN": "生成阅读报告",
        "en": "Build reading report"
      },
      "entry": "main.js",
      "surface": "library",
      "scope": "selection"
    }
  ],
  "settings": [
    {
      "key": "days",
      "type": "select",
      "label": {
        "zh-CN": "统计区间",
        "en": "Window"
      },
      "description": {
        "zh-CN": "最近多少天的阅读记录。",
        "en": "How many recent days to include."
      },
      "options": [
        "7",
        "30",
        "90",
        "365"
      ],
      "defaultValue": "30"
    },
    {
      "key": "top_books",
      "type": "number",
      "label": {
        "zh-CN": "书目数量",
        "en": "Books listed"
      },
      "defaultValue": 5
    },
    {
      "key": "copy",
      "type": "toggle",
      "label": {
        "zh-CN": "同时复制到剪贴板",
        "en": "Also copy to clipboard"
      },
      "defaultValue": true
    }
  ]
}
