{
  "schemaVersion": 1,
  "hostApi": 1,
  "id": "com.modu.vocab-notebook",
  "version": "1.0.0",
  "name": {
    "zh-CN": "生词本",
    "en": "Vocabulary notebook"
  },
  "description": {
    "zh-CN": "查词后把生词存入插件自己的生词本，可随时复习、导出或清空。演示 storage.*、dictionary.lookup 与 translate.text。",
    "en": "Keep looked-up words in a notebook the plugin owns, then review, export or clear it. Demonstrates storage.*, dictionary.lookup and translate.text."
  },
  "author": {
    "name": "Modu contributors",
    "url": "https://github.com/sobranie2406/modureader"
  },
  "license": "MIT",
  "minAppVersion": "1.3.10",
  "capabilities": [
    "script:run",
    "ui:selection-action",
    "storage:plugin",
    "dictionary:lookup",
    "translate:invoke",
    "clipboard:write",
    "ui:dialog"
  ],
  "contributes": [
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "add-word",
      "name": {
        "zh-CN": "加入生词本",
        "en": "Add to notebook"
      },
      "entry": "add.js",
      "surface": "selection",
      "scope": "selection"
    },
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "review-words",
      "name": {
        "zh-CN": "复习生词本",
        "en": "Review notebook"
      },
      "entry": "review.js",
      "surface": "library",
      "scope": "selection"
    }
  ],
  "settings": [
    {
      "key": "translate_on_add",
      "type": "toggle",
      "label": {
        "zh-CN": "加入时自动翻译",
        "en": "Translate when adding"
      },
      "description": {
        "zh-CN": "使用「设置 → 翻译」中选择的引擎，可能产生翻译额度消耗。",
        "en": "Uses the engine chosen in Settings → Translate; may consume translation quota."
      },
      "defaultValue": true
    },
    {
      "key": "max_entries",
      "type": "number",
      "label": {
        "zh-CN": "最多保存词条",
        "en": "Maximum entries"
      },
      "defaultValue": 300
    }
  ]
}
