{
  "app": {
    "signingConfigs": [],
    "products": [{
      "name": "default",
      "compatibleSdkVersion": "5.0.5(17)",
      "compileSdkVersion": "26.0.0",
      "targetSdkVersion": "6.1.1(24)",
      "runtimeOS": "HarmonyOS"
    }],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "profile" },
      { "name": "release" }
    ]
  },
  "modules": [{
    "name": "entry",
    "srcPath": "./entry",
    "targets": [{ "name": "default", "applyToProducts": ["default"] }]
  }]
}
