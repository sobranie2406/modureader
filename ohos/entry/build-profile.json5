{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": ["arm64-v8a"]
    },
    "nativeLib": {
      "debugSymbol": {
        "strip": true,
        "exclude": ["**/libonnxruntime.so"]
      }
    }
  },
  "targets": [
    { "name": "default", "runtimeOS": "HarmonyOS" },
    { "name": "ohosTest" }
  ]
}
