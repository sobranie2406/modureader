[Unit]
Description=Modu Baidu authorization broker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
StateDirectory=modu-baidu-auth
StateDirectoryMode=0700
LoadCredential=config.json:/etc/modu-baidu-auth/config.json
Environment=MODU_AUTH_CONFIG=%d/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/modu-baidu-auth/venv/bin/python /opt/modu-baidu-auth/broker.py
Restart=on-failure
RestartSec=10
UMask=0077
MemoryHigh=96M
MemoryMax=128M
CPUQuota=20%
Nice=10
OOMScoreAdjust=800
TasksMax=24
LimitNOFILE=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
