{
  "schemaVersion": 1,
  "hostApi": 1,
  "id": "com.modu.web-clipper",
  "version": "1.1.1",
  "name": {"zh-CN": "网页稍后阅读", "en": "Web clipper"},
  "description": {"zh-CN": "提取网页正文，保存为 Markdown 或加入书架。", "en": "Capture an article as Markdown or add it to your bookshelf."},
  "author": {"name": "Modu"},
  "license": "MIT",
  "minAppVersion": "1.3.10",
  "capabilities": ["script:run", "article:capture", "article:extract"],
  "contributes": [
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "capture",
      "name": {"zh-CN": "网页稍后阅读", "en": "Web clipper"},
      "entry": "main.js",
      "surface": "library"
    },
    {
      "kind": "scriptAction",
      "schema": 1,
      "id": "extract",
      "name": {"zh-CN": "提取网页正文", "en": "Extract article"},
      "entry": "extract.js",
      "surface": "article",
      "scope": "selection"
    }
  ],
  "settings": [
    {"key": "include_metadata", "type": "toggle", "label": {"zh-CN": "保留作者和日期", "en": "Keep author and date"}, "defaultValue": true},
    {"key": "include_images", "type": "toggle", "label": {"zh-CN": "保留图片链接", "en": "Keep image links"}, "defaultValue": true}
  ]
}
